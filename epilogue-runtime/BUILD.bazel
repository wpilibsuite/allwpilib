load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_junit5_test", "wpilib_java_library")

wpilib_java_library(
    name = "epilogue-java",
    srcs = glob(["src/main/java/**/*.java"]),
    maven_artifact_name = "epilogue-runtime-java",
    maven_group_id = "org.wpilib.epilogue",
    visibility = ["//visibility:public"],
    deps = [
        "//hal:hal-java",
        "//ntcore:ntcore-java",
        "//telemetry:telemetry-java",
        "//tunables:tunables-java",
        "//wpilibj:wpilibj-java",
        "//wpimath:wpimath-java",
        "//wpiunits:wpiunits-java",
    ],
)

wpilib_java_junit5_test(
    name = "epilogue-test",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [
        ":epilogue-java",
        "//telemetry:telemetry-java",
        "//wpiunits:wpiunits-java",
    ],
)
