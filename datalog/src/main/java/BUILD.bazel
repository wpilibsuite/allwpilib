load("//shared/bazel/rules:jni_rules.bzl", "wpilib_jni_java_library")

wpilib_jni_java_library(
    name = "datalog-java",
    srcs = glob(["**/*.java"]),
    maven_artifact_name = "datalog-java",
    maven_group_id = "org.wpilib.datalog",
    native_libs = ["//datalog:shared/datalogjni"],
    visibility = ["//visibility:public"],
    deps = [
        "//wpiutil/src/main/java",
        "@maven//:us_hebi_quickbuf_quickbuf_runtime",
    ],
)

alias(
    name = "java",
    actual = ":datalog-java",
    visibility = ["//visibility:public"],
)
