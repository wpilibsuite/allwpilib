load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "test_headers",
    hdrs = glob([
        "include/**",
    ]),
    strip_include_prefix = "include",
)

cc_test(
    name = "wpimath_tests",
    size = "medium",
    srcs = glob([
        "cpp/**/*.cpp",
        "cpp/**/*.hpp",
    ]),
    deps = [
        ":test_headers",
        "//thirdparty/catch2",
        "//wpimath",
    ],
)

alias(
    name = "native",
    actual = ":wpimath_tests",
)
