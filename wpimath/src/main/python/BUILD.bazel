load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_pybind_build_info")
load(":robotpy_pybind_build_info.bzl", "define_pybind_library", "publish_library_casters", "wpimath_extension")

PYBIND_PKGCFG_DEPS = [
    "//telemetry:native/telemetry/robotpy-native-telemetry.pc",
    "//telemetry/src/main/python:python.generated_pkgcfg_files",
    "//tunables:native/tunables/robotpy-native-tunables.pc",
    "//tunables/src/main/python:python.generated_pkgcfg_files",
    "//wpimath:native/wpimath/robotpy-native-wpimath.pc",
    "//wpiutil:native/wpiutil/robotpy-native-wpiutil.pc",
    "//wpiutil/src/main/python:python.generated_pkgcfg_files",
]

generate_robotpy_pybind_build_info(
    name = "robotpy-wpimath-generator",
    additional_srcs = ["//wpimath:robotpy-native-wpimath.copy_headers"],
    package_root_file = "wpimath/__init__.py",
    pkgcfgs = PYBIND_PKGCFG_DEPS,
    yaml_files = glob(["semiwrap/**/*.yml"]),
)

publish_library_casters()

wpimath_extension(
    srcs = ["wpimath/src/wpimath.cpp"],
    extra_hdrs = glob(["wpimath/_impl/src/**/*.h"]),
)

define_pybind_library(
    name = "python",
    extra_pybind_hdrs = glob(["**/*.h"]),
    pkgcfgs = PYBIND_PKGCFG_DEPS,
)
