load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    copyright_notice = "Copyright (c) 2018-2026 Omar Cornut",
    license_kind = "@rules_license//licenses/generic:restricted",
    license_text = "imgui_test_engine/LICENSE.txt",
    package_name = "Dear ImGui Test Engine",
    package_url = "https://github.com/ocornut/imgui_test_engine",
)

filegroup(
    name = "sources",
    testonly = True,
    srcs = [
        "imgui_test_engine/imgui_capture_tool.cpp",
        "imgui_test_engine/imgui_te_context.cpp",
        "imgui_test_engine/imgui_te_coroutine.cpp",
        "imgui_test_engine/imgui_te_engine.cpp",
        "imgui_test_engine/imgui_te_exporters.cpp",
        "imgui_test_engine/imgui_te_perftool.cpp",
        "imgui_test_engine/imgui_te_ui.cpp",
        "imgui_test_engine/imgui_te_utils.cpp",
    ],
)

filegroup(
    name = "headers",
    testonly = True,
    srcs = glob([
        "imgui_test_engine/**/*.h",
    ]),
)

cc_library(
    name = "header_paths",
    testonly = True,
    hdrs = [":headers"],
    includes = [
        ".",
        "imgui_test_engine",
    ],
)
