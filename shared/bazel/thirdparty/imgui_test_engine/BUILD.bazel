load("@rules_cc//cc:defs.bzl", "cc_library")
load("//shared/bazel/rules:imgui_test.bzl", "IMGUI_TEST_ENGINE_DEFINES", "imgui_test_target_compatible_with")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "imgui_test_engine",
    testonly = True,
    srcs = select({
        "//shared/bazel/rules:with_imgui_tests_enabled": [
            "@imgui_test_engine//:sources",
        ],
        "//conditions:default": [],
    }),
    hdrs = select({
        "//shared/bazel/rules:with_imgui_tests_enabled": [
            "@imgui_test_engine//:headers",
        ],
        "//conditions:default": [],
    }),
    defines = IMGUI_TEST_ENGINE_DEFINES,
    target_compatible_with = imgui_test_target_compatible_with(),
    deps = select({
        "//shared/bazel/rules:with_imgui_tests_enabled": [
            "//thirdparty/imgui_suite:imgui",
            "@imgui_test_engine//:header_paths",
        ],
        "//conditions:default": [],
    }),
)
