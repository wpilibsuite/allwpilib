+def _link_without_symlink_privilege(*, from_, to):
+  # A relative symlink target is relative to the link's directory.
+  to = normpath(join(dirname(from_), to))
+  if os.path.lexists(from_):
+    return
+  if os.path.isdir(to):
+    # A junction needs no privilege, and shutil.rmtree removes one
+    # without descending into it.
+    import _winapi
+    _winapi.CreateJunction(to, from_)
+    return
+  try:
+    os.link(to, from_)
+  except OSError:
