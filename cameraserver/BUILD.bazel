load("@bzlmodrio-opencv//libraries/cpp/opencv:libraries.bzl", "opencv_shared_libraries")
load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_cc_project")

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "src/main/native/include/**/*",
    ]),
    visibility = ["//visibility:public"],
)

wpilib_cc_library(
    name = "cameraserver",
    srcs = glob(["src/main/native/cpp/**"]),
    hdrs = glob(["src/main/native/include/**/*"]),
    includes = [
        "cpp",
        "src/main/native/include",
    ],
    strip_include_prefix = "src/main/native/include",
    visibility = ["//visibility:public"],
    deps = [
        "//cscore",
        "//hal:wpiHal",
        "//ntcore",
        "//wpilibc",
    ],
)

wpilib_cc_shared_library(
    name = "shared/cameraserver",
    dynamic_deps = [
        "//cscore:shared/cscore",
        "//hal:shared/wpiHal",
        "//ntcore:shared/ntcore",
        "//telemetry:shared/telemetry",
        "//tunables:shared/tunables",
        "//wpilibc:shared/wpilibc",
        "//wpiutil:shared/wpiutil",
    ] + opencv_shared_libraries,
    visibility = ["//visibility:public"],
    deps = [":cameraserver"],
)

wpilib_cc_static_library(
    name = "static/cameraserver",
    static_deps = [
        "//cscore:static/cscore",
        "//hal:static/wpiHal",
        "//ntcore:static/ntcore",
        "//telemetry:static/telemetry",
        "//tunables:static/tunables",
        "//wpilibc:static/wpilibc",
        "//wpiutil:static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [":cameraserver"],
)

package_default_cc_project(
    name = "cameraserver",
    maven_artifact_name = "cameraserver-cpp",
    maven_group_id = "org.wpilib.cameraserver",
)
