load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_library")

wpilib_java_library(
    name = "cameraserver-java",
    srcs = glob(["**/*.java"]),
    maven_artifact_name = "cameraserver-java",
    maven_group_id = "org.wpilib.cameraserver",
    visibility = ["//visibility:public"],
    deps = [
        "//cscore/src/main/java",
        "//hal/src/main/java",
        "//ntcore/src/main/java",
        "//telemetry/src/main/java",
        "//tunables/src/main/java",
        "//wpilibj/src/main/java",
        "//wpimath/src/main/java",
        "//wpinet/src/main/java",
        "//wpiutil/src/main/java",
        "@bzlmodrio-opencv//libraries/java/opencv",
    ],
)

alias(
    name = "java",
    actual = ":cameraserver-java",
    visibility = ["//visibility:public"],
)
