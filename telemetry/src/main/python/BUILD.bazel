load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_pybind_build_info")
load(":robotpy_pybind_build_info.bzl", "define_pybind_library", "telemetry_extension")

PYBIND_PKGCFG_DEPS = [
    "//telemetry:native/telemetry/robotpy-native-telemetry.pc",
    "//wpiutil:native/wpiutil/robotpy-native-wpiutil.pc",
    "//wpiutil/src/main/python:python.generated_pkgcfg_files",
]

generate_robotpy_pybind_build_info(
    name = "robotpy-telemetry-generator",
    additional_srcs = ["//telemetry:robotpy-native-telemetry.copy_headers"] + glob(["telemetry/src/rpy/*.h"]),
    package_root_file = "telemetry/__init__.py",
    pkgcfgs = PYBIND_PKGCFG_DEPS,
    yaml_files = glob(["semiwrap/*.yml"]),
)

telemetry_extension(
    srcs = glob(["telemetry/src/**/*.cpp"]),
    extra_hdrs = glob(["telemetry/src/**/*.h"]),
    header_to_dat_deps = glob(["telemetry/src/**"]),
    includes = [
        "telemetry",
        "telemetry/src",
    ],
)

define_pybind_library(
    name = "python",
    extra_pybind_hdrs = glob(["**/*.h"]),
    pkgcfgs = PYBIND_PKGCFG_DEPS,
)
