load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_library")

wpilib_java_library(
    name = "telemetry-java",
    srcs = glob(["**/*.java"]),
    maven_artifact_name = "telemetry-java",
    maven_group_id = "org.wpilib.telemetry",
    visibility = ["//visibility:public"],
    deps = [
        "//wpiutil/src/main/java",
        "@maven//:us_hebi_quickbuf_quickbuf_runtime",
    ],
)

alias(
    name = "java",
    actual = ":telemetry-java",
    visibility = ["//visibility:public"],
)
