load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//:mappings.bzl", "pkg_files")
load("//hal:robotpy_native_build_info.bzl", "define_native_wrapper")
load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:jni_rules.bzl", "wpilib_jni_cc_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_jni_project")
load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_native_wrapper_build_info")

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "src/main/native/include/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)

MRCLIB_SRCS = glob(["src/main/native/cpp/mrclib/*.cpp"])

filegroup(
    name = "platform-srcs",
    srcs = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": glob([
            "src/main/native/systemcore/**/*.cpp",
            "src/main/native/systemcore/**/*.h",
            "src/main/native/systemcore/**/*.hpp",
        ]) + MRCLIB_SRCS,
        "//conditions:default": glob([
            "src/main/native/sim/**/*.cpp",
            "src/main/native/sim/**/*.hpp",
        ]),
    }),
)

pkg_files(
    name = "hal-sim-pkg",
    srcs = glob([
        "src/main/native/sim/**/*.cpp",
        "src/main/native/sim/**/*.hpp",
    ]),
    strip_prefix = "src/main/native",
)

pkg_files(
    name = "hal-systemcore-pkg",
    srcs = glob([
        "src/main/native/systemcore/**/*.cpp",
        "src/main/native/systemcore/**/*.hpp",
    ]),
    strip_prefix = "src/main/native",
)

wpilib_cc_library(
    name = "wpiHal",
    srcs = [":platform-srcs"] + glob([
        "src/main/native/cpp/*.cpp",
        "src/main/native/cpp/handles/*.cpp",
    ]),
    hdrs = glob([
        "src/main/native/include/**/*.h",
        "src/main/native/include/**/*.hpp",
    ]),
    extra_src_pkg_files = [
        ":hal-sim-pkg",
        ":hal-systemcore-pkg",
        "//hal/src/main/java:hal-java-jni-hdrs-pkg",
    ],
    includes = ["src/main/native/include"],
    strip_include_prefix = "src/main/native/include",
    visibility = ["//visibility:public"],
    deps = [
        "//ntcore",
        "//wpinet",
        "//wpiutil",
        "@mrclib_headers//:headers",
    ] + select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": [
            "//shared/bazel/thirdparty/mrclib",
        ],
        "//conditions:default": [
        ],
    }),
)

cc_library(
    name = "wpiHalMrc",
    srcs = MRCLIB_SRCS,
    visibility = ["//visibility:public"],
    deps = [
        ":wpiHal-headers",
        "//shared/bazel/thirdparty/mrclib",
        "//wpiutil",
    ],
)

wpilib_cc_shared_library(
    name = "shared/wpiHal",
    dynamic_deps = [
        "//ntcore:shared/ntcore",
        "//wpinet:shared/wpinet",
        "//wpiutil:shared/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":wpiHal",
    ],
)

wpilib_cc_static_library(
    name = "static/wpiHal",
    static_deps = [
        "//ntcore:static/ntcore",
        "//wpinet:static/wpinet",
        "//wpiutil:static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":wpiHal",
    ],
)

wpilib_jni_cc_library(
    name = "wpiHaljni",
    srcs = glob([
        "src/main/native/cpp/jni/**/*.cpp",
        "src/main/native/cpp/jni/**/*.hpp",
    ]),
    java_dep = "//hal/src/main/java:hal-java",
    visibility = ["//visibility:public"],
    deps = [
        ":wpiHal",
    ],
)

wpilib_cc_shared_library(
    name = "shared/wpiHaljni",
    auto_export_windows_symbols = False,
    dynamic_deps = [
        ":shared/wpiHal",
        "//wpiutil:shared/wpiutil",
    ],
    use_debug_name = False,
    visibility = ["//visibility:public"],
    deps = [
        ":wpiHaljni",
    ],
)

package_default_jni_project(
    name = "wpiHal",
    maven_artifact_name = "hal-cpp",
    maven_group_id = "org.wpilib.hal",
)

generate_robotpy_native_wrapper_build_info(
    name = "robotpy-native-wpihal-generator",
    module_include_targets = {
        "@mrclib_headers//:all_headers": "include",
    },
    pyproject_toml = "src/main/native/pyproject.toml",
)

# Alias to make robotpy gen simpler.
alias(
    name = "shared/MrcLib",
    actual = "//shared/bazel/thirdparty/mrclib:MrcLib",
)

define_native_wrapper(
    name = "robotpy-native-wpihal",
)
