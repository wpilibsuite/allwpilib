load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//shared/bazel/rules:imgui_test.bzl", "wpilib_imgui_cc_test")

cc_test(
    name = "tests",
    size = "small",
    srcs = glob(
        ["**/*.cpp"],
        exclude = ["imgui/**"],
    ),
    tags = [
        "wpi-cpp-gui",
    ],
    deps = [
        "//glass",
        "//thirdparty/catch2",
    ],
)

wpilib_imgui_cc_test(
    name = "glass-imgui-test",
    size = "small",
    srcs = [
        "//glass:app-native-srcs",
        "//glass:generate-resources",
        "//glass:generate-version",
    ] + glob(["imgui/**"]),
    deps = [
        "//glass:glassnt_for_tests",
    ],
)
