load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//shared/bazel/rules:imgui_test.bzl", "wpilib_imgui_cc_test")
load("//shared/bazel/rules:packaging.bzl", "package_binary_cc_project")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//shared/bazel/rules/gen:gen-version-file.bzl", "generate_version_file")

generate_resources(
    name = "generate-resources",
    namespace = "dlt",
    prefix = "DLT",
    resource_files = glob(["src/main/native/resources/*"]),
)

generate_version_file(
    name = "generate-version",
    output_file = "WPILibVersion.cpp",
    template = "src/main/generate/WPILibVersion.cpp.in",
)

cc_library(
    name = "cli-lib",
    srcs = [
        "src/main/native/cli/Cli.cpp",
        "src/main/native/cpp/CsvExport.cpp",
        "src/main/native/cpp/Sftp.cpp",
        ":generate-version",
    ],
    hdrs = [
        "src/main/native/cli/Cli.hpp",
        "src/main/native/cpp/CsvExport.hpp",
        "src/main/native/cpp/CsvTable.hpp",
        "src/main/native/cpp/Sftp.hpp",
    ],
    defines = ["LIBSSH_STATIC"],
    includes = [
        "src/main/native/cli",
        "src/main/native/cpp",
    ],
    linkopts = select({
        "@platforms//os:osx": [
            "-framework",
            "Kerberos",
        ],
        "@platforms//os:windows": [
            "-DEFAULTLIB:ws2_32.lib",
            "-DEFAULTLIB:advapi32.lib",
            "-DEFAULTLIB:crypt32.lib",
            "-DEFAULTLIB:user32.lib",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//datalog",
        "//shared/bazel/thirdparty/libssh",
        "//wpiutil",
    ],
)

cc_binary(
    name = "datalogtool-cli",
    srcs = ["src/main/native/cli/main.cpp"],
    deps = [":cli-lib"],
)

cc_binary(
    name = "datalogtool",
    srcs = glob(["src/main/native/cpp/*"]) + [
        ":generate-resources",
        ":generate-version",
    ],
    defines = ["LIBSSH_STATIC"],
    linkopts = select({
        "@platforms//os:osx": [
            "-framework",
            "Kerberos",
        ],
        "@platforms//os:windows": [
            "-DEFAULTLIB:ws2_32.lib",
            "-DEFAULTLIB:advapi32.lib",
            "-DEFAULTLIB:crypt32.lib",
            "-DEFAULTLIB:user32.lib",
            "-SUBSYSTEM:WINDOWS",
        ],
        "@wpilib_toolchains//conditions:linux_x86_64": [],
        "@wpilib_toolchains//constraints/combined:is_cross_compiler": [],
    }),
    tags = [
        "wpi-cpp-gui",
    ],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//datalog",
        "//glass",
        "//shared/bazel/thirdparty/libssh",
    ],
)

cc_test(
    name = "datalogtool-test",
    size = "small",
    srcs = glob(["src/test/native/cpp/**"]) + ["src/main/native/cpp/CsvTable.hpp"],
    includes = ["src/main/native/cpp"],
    deps = [
        ":cli-lib",
        "//thirdparty/catch2",
        "//wpiutil",
    ],
)

wpilib_imgui_cc_test(
    name = "datalogtool-imgui-test",
    size = "small",
    srcs = glob([
        "src/main/native/cpp/*",
        "src/test/native/imgui/**",
    ]) + [
        ":generate-resources",
        ":generate-version",
    ],
    defines = ["LIBSSH_STATIC"],
    linkopts = select({
        "@platforms//os:osx": [
            "-framework",
            "Kerberos",
        ],
        "@platforms//os:windows": [
            "-DEFAULTLIB:ws2_32.lib",
            "-DEFAULTLIB:advapi32.lib",
            "-DEFAULTLIB:crypt32.lib",
            "-DEFAULTLIB:user32.lib",
        ],
        "@wpilib_toolchains//conditions:linux_x86_64": [],
        "@wpilib_toolchains//constraints/combined:is_cross_compiler": [],
    }),
    deps = [
        "//datalog",
        "//glass:glass_for_tests",
        "//shared/bazel/thirdparty/libssh",
    ],
)

package_binary_cc_project(
    name = "datalogtool",
    extra_binaries = [":datalogtool-cli"],
    maven_artifact_name = "DataLogTool",
    maven_group_id = "org.wpilib.tools",
)
