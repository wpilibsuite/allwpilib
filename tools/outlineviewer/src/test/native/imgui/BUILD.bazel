load("//shared/bazel/rules:imgui_test.bzl", "wpilib_imgui_cc_test")

wpilib_imgui_cc_test(
    name = "outlineviewer_imgui_tests",
    size = "small",
    srcs = [
        "//tools/outlineviewer:generate-resources",
        "//tools/outlineviewer:generate-version",
        "//tools/outlineviewer:main-native-srcs",
    ] + glob(["*.cpp"]),
    deps = [
        "//glass:glassnt_for_tests",
    ],
)

alias(
    name = "imgui",
    actual = ":outlineviewer_imgui_tests",
)
