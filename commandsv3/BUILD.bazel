load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_python//python:defs.bzl", "py_binary")
load("//commandsv3:generate.bzl", "generate_commandsv3")
load("//shared/bazel/rules:java_rules.bzl", "patch_module", "wpilib_java_library")

filegroup(
    name = "test-resources",
    srcs = glob(["src/test/resources/**"]),
    visibility = ["//commandsv3/src/test/java:__pkg__"],
)

py_binary(
    name = "generate_files",
    srcs = ["generate_files.py"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        requirement("jinja2"),
        "//:generation",
    ],
)

filegroup(
    name = "templates",
    srcs = glob([
        "src/generate/main/**",
        "src/main/proto/**",
    ]) + [
        "//wpilibj:hid_schema",
    ],
)

generate_commandsv3(
    name = "generate_commandsv3",
)

write_source_files(
    name = "write_commandsv3",
    diff_args = ["-u"],
    files = {
        "src/generated": ":generate_commandsv3",
    },
    suggested_update_target = "//:write_all",
    tags = ["pregeneration"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "generated_java",
    srcs = glob(["src/generated/main/java/**/*.java"]),
)

wpilib_java_library(
    name = "commandsv3-java",
    srcs = glob(["src/main/java/**/*.java"]) + [":generated_java"],
    exported_plugins = ["//javacPlugin:plugin"],
    javacopts = patch_module(
        "wpilib.command3",
        ["commandsv3/src/generated/main/java"],
    ) + [
        "-Xlint:-module",
    ],
    maven_artifact_name = "commandsv3-java",
    maven_group_id = "org.wpilib",
    plugins = ["//javacPlugin:plugin"],
    visibility = ["//visibility:public"],
    deps = [
        "//hal:hal-java",
        "//ntcore:ntcore-java",
        "//tunables:tunables-java",
        "//wpiannotations",
        "//wpilibj:wpilibj-java",
        "//wpimath:wpimath-java",
        "//wpinet:wpinet-java",
        "//wpiunits:wpiunits-java",
        "//wpiutil:wpiutil-java",
        "@maven//:us_hebi_quickbuf_quickbuf_runtime",
    ],
)
