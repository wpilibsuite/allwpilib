load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_python//python:defs.bzl", "py_binary")
load("//commandsv3:generate.bzl", "generate_commandsv3")

filegroup(
    name = "test-resources",
    srcs = ["src/test/resources/META-INF/services/org.junit.jupiter.api.extension.Extension"],
    visibility = ["//commandsv3/src/test/java:__pkg__"],
)

py_binary(
    name = "generate_files",
    srcs = ["generate_files.py"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        requirement("jinja2"),
        "//:generation",
    ],
)

filegroup(
    name = "templates",
    srcs = glob([
        "src/generate/main/java/*.jinja",
        "src/main/proto/*.proto",
    ]) + [
        "//wpilibj:hid_schema",
    ],
)

generate_commandsv3(
    name = "generate_commandsv3",
)

write_source_files(
    name = "write_commandsv3",
    diff_args = ["-u"],
    files = {
        "src/generated": ":generate_commandsv3",
    },
    suggested_update_target = "//:write_all",
    tags = ["pregeneration"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "generated_java",
    srcs = glob(["src/generated/main/java/**/*.java"]),
    visibility = ["//commandsv3:__subpackages__"],
)

filegroup(
    name = "proto_files",
    srcs = ["src/main/proto/protobuf_commands.proto"],
    visibility = ["//commandsv3/src/main/java:__pkg__"],
)
