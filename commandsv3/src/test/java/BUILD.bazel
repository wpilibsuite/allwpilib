load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_junit5_test")

wpilib_java_junit5_test(
    name = "java",
    srcs = glob(["**/*.java"]),
    jvm_flags = [
        "--add-opens",
        "java.base/jdk.internal.vm=ALL-UNNAMED",
        "--add-opens",
        "java.base/java.lang=ALL-UNNAMED",
    ],
    plugins = [
        "//epilogue-processor/src/main/java:plugin",
    ],
    resource_strip_prefix = "commandsv3/src/test/resources",
    resources = ["//commandsv3:test-resources"],
    deps = [
        "//commandsv3/src/main/java",
        "//epilogue-runtime/src/main/java",
        "//hal/src/main/java",
        "//ntcore/src/main/java",
        "//telemetry/src/main/java",
        "//tunables/src/main/java",
        "//wpiannotations/src/main/java",
        "//wpilibj/src/main/java",
        "//wpimath/src/main/java",
        "//wpiunits/src/main/java",
        "//wpiutil/src/main/java",
        "@maven//:org_mockito_mockito_core",
        "@maven//:us_hebi_quickbuf_quickbuf_runtime",
    ],
)
