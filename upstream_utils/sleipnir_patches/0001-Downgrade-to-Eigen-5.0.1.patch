+++ b/include/sleipnir/autodiff/variable_block.hpp
@@ -164,7 +164,7 @@ class VariableBlock : public SleipnirBase {
 
     for (int row = 0; row < rows(); ++row) {
       for (int col = 0; col < cols(); ++col) {
-        (*this)[row, col] = values[row, col];
+        (*this)[row, col] = values(row, col);
       }
     }
 
@@ -181,7 +181,7 @@ class VariableBlock : public SleipnirBase {
 
     for (int row = 0; row < rows(); ++row) {
       for (int col = 0; col < cols(); ++col) {
-        (*this)[row, col].set_value(values[row, col]);
+        (*this)[row, col].set_value(values(row, col));
       }
     }
   }
@@ -441,7 +441,11 @@ class VariableBlock : public SleipnirBase {
       for (int j = 0; j < rhs.cols(); ++j) {
         Variable sum{Scalar(0)};
         for (int k = 0; k < cols(); ++k) {
-          sum += lhs_old_row[k] * rhs[k, j];
+          if constexpr (EigenMatrixLike<decltype(rhs)>) {
+            sum += lhs_old_row[k] * rhs(k, j);
+          } else {
+            sum += lhs_old_row[k] * rhs[k, j];
+          }
         }
         (*this)[i, j] = sum;
       }
@@ -487,7 +491,11 @@ class VariableBlock : public SleipnirBase {
 
     for (int row = 0; row < rows(); ++row) {
       for (int col = 0; col < cols(); ++col) {
-        (*this)[row, col] += rhs[row, col];
+        if constexpr (EigenMatrixLike<decltype(rhs)>) {
+          (*this)[row, col] += rhs(row, col);
+        } else {
+          (*this)[row, col] += rhs[row, col];
+        }
       }
     }
 
@@ -519,7 +527,11 @@ class VariableBlock : public SleipnirBase {
 
     for (int row = 0; row < rows(); ++row) {
       for (int col = 0; col < cols(); ++col) {
-        (*this)[row, col] -= rhs[row, col];
+        if constexpr (EigenMatrixLike<decltype(rhs)>) {
+          (*this)[row, col] -= rhs(row, col);
+        } else {
+          (*this)[row, col] -= rhs[row, col];
+        }
       }
     }
 
@@ -599,7 +611,7 @@ class VariableBlock : public SleipnirBase {
 
     for (int row = 0; row < rows(); ++row) {
       for (int col = 0; col < cols(); ++col) {
-        result[row, col] = value(row, col);
+        result(row, col) = value(row, col);
       }
     }
 
