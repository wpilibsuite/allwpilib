+
+TEST(SmallSetVector, InsertionOrderAfterRemovalAndReinsertion) {
+  for (int Size : {3, 32}) {
+    SmallSetVector<int, 4> Set;
+    std::vector<int> Expected;
+    for (int I = 0; I < Size; ++I) {
+      EXPECT_TRUE(Set.insert(I));
+      EXPECT_FALSE(Set.insert(I));
+      Expected.push_back(I);
+    }
+    CHECK_THAT(Set, Catch::Matchers::RangeEquals(Expected));
+    EXPECT_EQ(Set.size(), Expected.size());
+    EXPECT_TRUE(Set.remove(1));
+    EXPECT_FALSE(Set.remove(1));
+    EXPECT_FALSE(Set.contains(1));
+    std::erase(Expected, 1);
+    CHECK_THAT(Set, Catch::Matchers::RangeEquals(Expected));
+    EXPECT_TRUE(Set.insert(1));
+    Expected.push_back(1);
+    CHECK_THAT(Set, Catch::Matchers::RangeEquals(Expected));
+  }
