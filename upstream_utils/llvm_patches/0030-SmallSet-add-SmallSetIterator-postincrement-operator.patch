From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: crueter <crueter@eden-emu.dev>
Date: Wed, 6 May 2026 12:42:53 -0400
Subject: [PATCH 30/32] SmallSet: add SmallSetIterator postincrement operator

Required for Xcode 26.4
---
 llvm/include/llvm/ADT/SmallSet.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/llvm/include/llvm/ADT/SmallSet.h b/llvm/include/llvm/ADT/SmallSet.h
index 38918175ea68dc4c67b6bf6cfd5bed1da200a512..46bb9a65fc0369a2c6d2d81d3d8ba18cb00704b1 100644
--- a/llvm/include/llvm/ADT/SmallSet.h
+++ b/llvm/include/llvm/ADT/SmallSet.h
@@ -123,6 +123,12 @@ public:
     return *this;
   }
 
+  SmallSetIterator operator++(int) { // Postincrement
+    SmallSetIterator Copy = *this;
+    ++(*this);
+    return Copy;
+  }
+
   const T &operator*() const { return IsSmall ? *VecIter : *SetIter; }
 };
 
