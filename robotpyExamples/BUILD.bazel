load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package_group(
    name = "example_kinds",
    packages = [
        "//robotpyExamples/examples",
        "//robotpyExamples/snippets",
    ],
)

exports_files(
    srcs = ["check_example_list.py"],
    visibility = [":example_kinds"],
)

py_binary(
    name = "check_example_list",
    srcs = ["check_example_list.py"],
    visibility = ["//visibility:private"],
)

py_console_script_binary(
    name = "robotpy",
    pkg = "@allwpilib_pip_deps//robotpy_cli",
    visibility = [
        "//developerRobot:__subpackages__",
        "//robotpyExamples:__subpackages__",
    ],
)

alias(
    name = "robotpy_entry_point",
    actual = "robotpy_entry_point.py",
    visibility = [
        "//developerRobot:__subpackages__",
        "//robotpyExamples:__subpackages__",
    ],
)
