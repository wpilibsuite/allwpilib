load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package_group(
    name = "example_kinds",
    packages = [
        "//robotpyExamples/examples",
        "//robotpyExamples/snippets",
    ],
)

exports_files(
    srcs = ["check_example_list.py"],
    visibility = [":example_kinds"],
)

py_binary(
    name = "check_example_list",
    srcs = ["check_example_list.py"],
    visibility = ["//visibility:private"],
)

py_binary(
    name = "generate_bazel_files",
    srcs = ["generate_bazel_files.py"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        requirement("tomli"),
    ],
)

py_console_script_binary(
    name = "robotpy",
    pkg = "@allwpilib_pip_deps//robotpy_cli",
)
