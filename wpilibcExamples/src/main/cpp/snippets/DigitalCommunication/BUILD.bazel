load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "DigitalCommunication_lib",
    hdrs = glob(["include/**/*.hpp"]),
    linkstatic = True,
    strip_include_prefix = "include",
    visibility = [
        "//wpilibcExamples/src/test/cpp/snippets/DigitalCommunication:__pkg__",
    ],
    deps = [
        "//wpilibc",
    ],
)

cc_binary(
    name = "DigitalCommunication",
    srcs = ["cpp/Robot.cpp"],
    tags = [
        "wpi-example",
    ],
    deps = [
        ":DigitalCommunication_lib",
    ],
)

exports_files(
    ["cpp/Robot.cpp"],
    visibility = [
        "//wpilibcExamples/src/test/cpp/snippets/DigitalCommunication:__pkg__",
    ],
)

# For allwpilib packaging
filegroup(
    name = "sources",
    srcs = glob([
        "cpp/**/*.cpp",
        "include/**/*.hpp",
    ]),
    visibility = [
        "//wpilibcExamples/src/main/cpp/snippets:__pkg__",
    ],
)
