load("@rules_cc//cc:cc_test.bzl", "cc_test")

filegroup(
    name = "sources",
    srcs = glob(["cpp/**/*.cpp"]),
    visibility = [
        "//wpilibcExamples/src/test/cpp/snippets:__pkg__",
    ],
)

cc_test(
    name = "DigitalCommunication",
    size = "small",
    srcs = [
        "cpp/DigitalCommunicationTest.cpp",
        "cpp/main.cpp",
        "//wpilibcExamples/src/main/cpp/snippets/DigitalCommunication:cpp/Robot.cpp",
    ],
    defines = ["RUNNING_WPILIB_TESTS=1"],
    tags = [
        "exclusive-if-local",
        "no-asan",
        "no-tsan",
        "no-ubsan",
        "wpi-example",
    ],
    deps = [
        "//thirdparty/catch2",
        "//wpilibcExamples/src/main/cpp/snippets/DigitalCommunication:DigitalCommunication_lib",
    ],
)
