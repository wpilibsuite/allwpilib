load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_pkg//:mappings.bzl", "pkg_files", "strip_prefix")

pkg_files(
    name = "examples",
    srcs = [pkg + ":sources" for pkg in subpackages.all()],
    prefix = "examples_test",
    strip_prefix = strip_prefix.from_root(package_name()),
    visibility = ["//wpilibcExamples:__pkg__"],
)
