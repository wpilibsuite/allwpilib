// A proto_type attribute with nothing to pick, since a bool is only a protobuf
// bool.

namespace wpi.aosnt.testing;

attribute "proto_type";

table BadAttribute {
  the_bool:bool (id: 0, proto_type: "sint32");
}

root_type BadAttribute;
