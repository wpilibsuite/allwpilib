load("@aos//aos/flatbuffers:generate.bzl", "static_flatbuffer")

# Schemas for FlatbufferToProtoTest. They are a package of their own so the
# path one uses to include another is the path its generated header is at.

static_flatbuffer(
    name = "flatbuffer_to_proto_test_fbs",
    srcs = ["flatbuffer_to_proto_test.fbs"],
    visibility = ["//aosnt:__pkg__"],
)

static_flatbuffer(
    name = "flatbuffer_to_proto_scalars_test_fbs",
    srcs = ["flatbuffer_to_proto_scalars_test.fbs"],
    visibility = ["//aosnt:__pkg__"],
)

