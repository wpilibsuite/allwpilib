    name = "flatbuffer_to_proto_spanning_test_fbs",
    srcs = ["flatbuffer_to_proto_spanning_test.fbs"],
    visibility = ["//aosnt:__pkg__"],
    deps = [":flatbuffer_to_proto_test_fbs"],
)

static_flatbuffer(
    name = "flatbuffer_to_proto_defaults_test_fbs",
