load("@aos//aos:config.bzl", "aos_config")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//shared/bazel/rules:packaging.bzl", "package_binary_cc_project")

cc_library(
    name = "aosnt",
    srcs = glob(["src/main/native/cpp/**"]),
    hdrs = glob(["src/main/native/include/**"]),
    strip_include_prefix = "src/main/native/include",
    visibility = ["//visibility:public"],
    deps = [
        "//aosnt/types:nt_types_fbs",
        "//ntcore",
        "//wpiutil",
        "@aos//aos:configuration",
        "@aos//aos/events:event_loop",
        "@aos_flatbuffers//:flatbuffers",
    ],
)

cc_binary(
    name = "aosnt-bridge",
    srcs = ["src/bridge/native/cpp/main.cpp"],
    # The Linux toolchains export every symbol (-rdynamic), which costs 1.3 MB
    # of symbol tables on a Systemcore and keeps every function a
    # --gc-sections root. Nothing loads the bridge's symbols dynamically.
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--no-export-dynamic",
            "-Wl,--gc-sections",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":aosnt",
        "//ntcore",
        "//wpiutil",
        "@aos//aos:configuration",
        "@aos//aos:init",
        "@aos//aos/events:shm_event_loop",
    ],
)

package_binary_cc_project(
    name = "aosnt-bridge",
    # aos_dump reads the channels the bridge publishes, so it is what you reach
    # for when a topic does not show up in NetworkTables.
    extra_binaries = ["@aos//aos:aos_dump"],
    maven_artifact_name = "aosnt-bridge",
    maven_group_id = "org.wpilib.aosnt",
    systemcore = True,
)

aos_config(
    name = "aos_config",
    src = "aos_config_source.json",
    flatbuffers = [
        "//aosnt/types:nt_types_fbs",
        "@aos//aos/events:event_loop_fbs",
        "@aos//aos/logging:dynamic_log_command_fbs",
        "@aos//aos/logging:log_message_fbs",
        "@aos//aos/testing/ping_pong:ping_fbs",
    ],
    visibility = ["//aosnt/src/test/native:__pkg__"],
)

# Two tagged channels with one name, which NtBridge refuses.
aos_config(
    name = "aos_duplicate_config",
    src = "aos_duplicate_config_source.json",
    flatbuffers = [
        "@aos//aos/events:event_loop_fbs",
        "@aos//aos/logging:dynamic_log_command_fbs",
        "@aos//aos/logging:log_message_fbs",
        "@aos//aos/testing/ping_pong:ping_fbs",
        "@aos//aos/testing/ping_pong:pong_fbs",
    ],
    visibility = ["//aosnt/src/test/native:__pkg__"],
)
