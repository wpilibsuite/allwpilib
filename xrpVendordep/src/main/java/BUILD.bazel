load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_library")

wpilib_java_library(
    name = "xrpVendordep-java",
    srcs = glob(["**/*.java"]),
    maven_artifact_name = "xrpVendordep-java",
    maven_group_id = "org.wpilib.xrpVendordep",
    visibility = ["//visibility:public"],
    deps = [
        "//hal/src/main/java",
        "//telemetry/src/main/java",
        "//tunables/src/main/java",
        "//wpilibj/src/main/java",
        "//wpimath/src/main/java",
        "//wpiutil/src/main/java",
    ],
)

alias(
    name = "java",
    actual = ":xrpVendordep-java",
    visibility = ["//visibility:public"],
)
