load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_jvm_external//:defs.bzl", "java_plugin_artifact")
load("@rules_pkg//:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_binary")
load("//fields:generate_fields.bzl", "generate_fields")
load("//fields:robotpy_native_build_info.bzl", "define_native_wrapper")
load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:java_rules.bzl", "patch_module", "wpilib_java_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_cc_project")
load("//shared/bazel/rules:publishing.bzl", "host_architectures")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_native_wrapper_build_info")

filegroup(
    name = "test-resources",
    srcs = glob(["src/test/resources/**"]),
    visibility = ["//fields/src/test/java:__pkg__"],
)

filegroup(
    name = "generated-native-include-files",
    srcs = glob(["src/generated/main/native/include/**/*"]),
    visibility = ["//fields:__subpackages__"],
)

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "src/main/native/include/**/*",
    ]) + [":generated-native-include-files"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "field-jsons",
    srcs = glob(["src/main/native/resources/**/*.json"]),
)

filegroup(
    name = "field-images",
    srcs = glob(
        [
            "src/main/native/resources/**/*.jpg",
            "src/main/native/resources/**/*.png",
        ],
    ),
)

filegroup(
    name = "templates",
    srcs = glob([
        "src/generate/**/*.jinja",
        "src/generate/*.json",
    ]),
)

py_binary(
    name = "generate_fields_script",
    srcs = ["generate_fields.py"],
    data = [
        ":field-jsons",
        ":templates",
    ],
    main = "generate_fields.py",
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [requirement("jinja2")],
)

py_binary(
    name = "convert_apriltag_layouts",
    srcs = ["convert_apriltag_layouts.py"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

generate_fields(
    name = "generate_fields",
)

write_source_files(
    name = "write_fields",
    diff_args = ["-u"],
    files = {
        "src/generated": ":generate_fields",
    },
    suggested_update_target = "//:write_all",
    tags = ["pregeneration"],
    visibility = ["//visibility:public"],
)

generate_resources(
    name = "generate-resources",
    namespace = "wpi::fields",
    prefix = "FIELDS",
    resource_files = [":field-jsons"],
)

generate_resources(
    name = "generate-image-resources",
    namespace = "wpi::fields",
    prefix = "FIELD_IMAGES",
    resource_files = [":field-images"],
)

pkg_files(
    name = "field-resource-srcs-pkg",
    srcs = [":generate-resources"],
    strip_prefix = "fields/src/main/native/resources/org/wpilib/fields",
)

pkg_files(
    name = "field-image-resource-srcs-pkg",
    srcs = [":generate-image-resources"],
    strip_prefix = "fields/src/main/native/resources/org/wpilib/fields",
)

pkg_files(
    name = "generated-native-field-srcs-pkg",
    srcs = ["src/generated/main/native/cpp/fields/fields.cpp"],
    strip_prefix = "src/generated/main/native/cpp/fields",
)

pkg_files(
    name = "generated-native-include-files-pkg",
    srcs = [":generated-native-include-files"],
    strip_prefix = "src/generated/main/native/include",
)

cc_library(
    name = "generated-native-include-files-lib",
    hdrs = [":generated-native-include-files"],
    strip_include_prefix = "src/generated/main/native/include",
)

wpilib_cc_library(
    name = "fields",
    srcs = [":generate-resources"] + [
        "src/generated/main/native/cpp/fields/fields.cpp",
        "src/main/native/cpp/Field.cpp",
        "src/main/native/cpp/FieldImage.cpp",
        "src/main/native/cpp/FieldTag.cpp",
    ],
    hdrs = glob(["src/main/native/include/**/*"]),
    extra_hdr_pkg_files = [
        ":generated-native-include-files-pkg",
    ],
    extra_src_pkg_files = [
        ":field-resource-srcs-pkg",
        ":generated-native-field-srcs-pkg",
    ],
    local_defines = ["WPILIB_EXPORTS"],
    strip_include_prefix = "src/main/native/include",
    visibility = ["//visibility:public"],
    deps = [
        ":generated-native-include-files-lib",
        "//wpimath",
        "//wpiutil",
    ],
)

wpilib_cc_shared_library(
    name = "shared/fields",
    auto_export_windows_symbols = False,
    dynamic_deps = [
        "//telemetry:shared/telemetry",
        "//tunables:shared/tunables",
        "//wpimath:shared/wpimath",
        "//wpiutil:shared/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fields",
    ],
)

wpilib_cc_library(
    name = "fieldimages",
    srcs = [":generate-image-resources"] + [
        "src/generated/main/native/cpp/fieldimages/field_images.cpp",
    ],
    hdrs = glob(["src/main/native/include/**/*"]),
    extra_hdr_pkg_files = [
        ":generated-native-include-files-pkg",
    ],
    extra_src_pkg_files = [
        ":field-image-resource-srcs-pkg",
    ],
    local_defines = ["WPILIB_EXPORTS"],
    srcs_pkg_root = "src/generated/main/native/cpp/fieldimages",  # This prevents fields sources from being packaged
    strip_include_prefix = "src/main/native/include",
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":generated-native-include-files-lib",
        "//wpiutil",
    ],
)

wpilib_cc_shared_library(
    name = "shared/fieldimages",
    visibility = ["//visibility:public"],
    deps = [
        ":fieldimages",
    ],
)

wpilib_cc_static_library(
    name = "static/fields",
    static_deps = [
        "//telemetry:static/telemetry",
        "//tunables:static/tunables",
        "//wpimath:static/wpimath",
        "//wpiutil:static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fields",
    ],
)

wpilib_cc_static_library(
    name = "static/fieldimages",
    static_lib_name = select({
        "@platforms//os:windows": "static/fieldimages.lib",
        "//conditions:default": "static/libfieldimages.a",
    }),
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":fieldimages",
    ],
)

wpilib_java_library(
    name = "fields-java",
    srcs = glob(["src/main/java/**/*.java"]) + glob([
        "src/generated/main/java/**/*.java",
    ]),
    extra_source_pkgs = ["resources"],
    javacopts = patch_module(
        "wpilib.gamefields",
        ["fields/src/generated/main/java"],
    ),
    maven_artifact_name = "fields-java",
    maven_group_id = "org.wpilib.fields",
    plugins = [
        java_plugin_artifact("io.avaje:avaje-jsonb-generator", "io.avaje.jsonb.generator.JsonbProcessor"),
    ],
    resource_strip_prefix = "fields/src/main/native/resources",
    resources = [":field-jsons"],
    visibility = ["//visibility:public"],
    deps = [
        "//wpimath:wpimath-java",
        "//wpiutil:wpiutil-java",
        "@maven//:io_avaje_avaje_json_core",
        "@maven//:io_avaje_avaje_jsonb",
    ],
)

wpilib_java_library(
    name = "field-images-java",
    maven_artifact_name = "field-images-java",
    maven_group_id = "org.wpilib.fields",
    resource_strip_prefix = "fields/src/main/native/resources",
    resources = [":field-images"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "resources",
    srcs = [":field-jsons"],
    strip_prefix = "src/main/native/resources/",
)

package_default_cc_project(
    name = "fieldimages",
    architectures = host_architectures,
    maven_artifact_name = "field-images-cpp",
    maven_group_id = "org.wpilib.fields",
)

package_default_cc_project(
    name = "fields",
    maven_artifact_name = "fields-cpp",
    maven_group_id = "org.wpilib.fields",
)

generate_robotpy_native_wrapper_build_info(
    name = "robotpy-native-fields-generator",
    generated_include_target = "//fields:generated-native-include-files",
    include_third_party_notices = True,
    pyproject_toml = "src/main/native/pyproject.toml",
)

define_native_wrapper(
    name = "robotpy-native-fields",
    pyproject_toml = "src/main/native/pyproject.toml",
)
