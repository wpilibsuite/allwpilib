load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_python//python:defs.bzl", "py_binary")
load("//drivers:generate.bzl", "generate_drivers")
load("//shared/bazel/rules:cc_rules.bzl", "third_party_cc_lib_helper", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_junit5_test", "wpilib_java_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_cc_project")

filegroup(
    name = "doxygen-files",
    srcs = glob(
        [
            "src/generated/main/native/include/**/*",
            "src/main/native/include/**/*",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "generate_pwm_motor_controllers",
    srcs = ["generate_pwm_motor_controllers.py"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [requirement("jinja2")],
)

filegroup(
    name = "templates",
    srcs = glob(["src/generate/**"]),
)

generate_drivers(
    name = "generate_drivers",
)

write_source_files(
    name = "write_drivers",
    diff_args = ["-u"],
    files = {
        "src/generated": ":generate_drivers",
    },
    suggested_update_target = "//:write_all",
    tags = ["pregeneration"],
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "generated_cc",
    include_root = "src/generated/main/native/include",
    src_root = "src/generated/main/native/cpp",
)

filegroup(
    name = "generated_java",
    srcs = glob(["src/generated/main/java/**/*.java"]),
)

wpilib_cc_library(
    name = "drivers",
    srcs = glob(
        ["src/main/native/cpp/**"],
        allow_empty = True,
    ),
    hdrs = glob(
        ["src/main/native/include/**"],
        allow_empty = True,
    ),
    includes = ["src/main/native/include"],
    strip_include_prefix = "src/main/native/include",
    third_party_libraries = [
        ":generated_cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//wpilibc",
    ],
)

wpilib_cc_shared_library(
    name = "shared/drivers",
    dynamic_deps = [
        "//datalog:shared/datalog",
        "//hal:shared/wpiHal",
        "//ntcore:shared/ntcore",
        "//wpilibc:shared/wpilibc",
        "//wpimath:shared/wpimath",
        "//wpinet:shared/wpinet",
        "//wpiutil:shared/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [":drivers"],
)

wpilib_cc_static_library(
    name = "static/drivers",
    static_deps = [
        "//datalog:static/datalog",
        "//hal:static/wpiHal",
        "//ntcore:static/ntcore",
        "//wpilibc:static/wpilibc",
        "//wpimath:static/wpimath",
        "//wpinet:static/wpinet",
        "//wpiutil:static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [":drivers"],
)

wpilib_java_library(
    name = "drivers-java",
    srcs = glob(
        ["src/main/java/**/*.java"],
        allow_empty = True,
    ) + [":generated_java"],
    maven_artifact_name = "drivers-java",
    maven_group_id = "org.wpilib.drivers",
    visibility = ["//visibility:public"],
    deps = [
        "//hal:hal-java",
        "//wpilibj:wpilibj-java",
        "//wpiunits:wpiunits-java",
        "//wpiutil:wpiutil-java",
    ],
)

cc_test(
    name = "drivers-cpp-test",
    size = "small",
    srcs = glob(["src/test/native/**/*.cpp"]),
    tags = [
        "no-tsan",
        "no-ubsan",
    ],
    deps = [
        ":drivers",
        "//thirdparty/googletest",
    ],
)

wpilib_java_junit5_test(
    name = "drivers-java-test",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [
        ":drivers-java",
        "//hal:hal-java",
        "//wpilibj:wpilibj-java",
        "//wpiunits:wpiunits-java",
        "//wpiutil:wpiutil-java",
    ],
)

cc_binary(
    name = "DevMain-Cpp",
    srcs = ["src/dev/native/cpp/main.cpp"],
    deps = [":drivers"],
)

java_binary(
    name = "DevMain-Java",
    srcs = ["src/dev/java/org/wpilib/drivers/DevMain.java"],
    main_class = "org.wpilib.drivers.DevMain",
    deps = [":drivers-java"],
)

package_default_cc_project(
    name = "drivers",
    maven_artifact_name = "drivers-cpp",
    maven_group_id = "org.wpilib.drivers",
)
